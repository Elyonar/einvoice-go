  "caseFields": "secret: current | previous | other | empty; header: header | rotating | <literal>; body: utf8 | reserialised; now: unix seconds (default t); toleranceSeconds (default 300); expect: ok | signature | tolerance | parse | missing | secret",
  "cases": [
    {"name": "a backend-signed delivery verifies and the event is returned", "secret": "current", "header": "header", "now": 1790000010, "expect": "ok"},
